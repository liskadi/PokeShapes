{
  "name": "pokeshapes",
  "private": true,
  "version": "1.0.0",
  "description": "PokéShapes - Daily Geometric Pokémon Guessing Game powered by Geometrize & PokéAPI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --host",
    "qa:tunnel": "npx --yes cloudflared tunnel --url http://localhost:4173",
    "qa:cloudflare": "npm run build && npx --yes wrangler pages deploy dist --project-name pokeshapes-qa"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "geometrizejs": "^0.0.19",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
